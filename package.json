{
  "name": "openmanuscript",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run test:i18n && npm run test:release-metadata && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "i18n:deepl:site:check": "node scripts/translate-site-incremental-with-deepl.mjs",
    "i18n:deepl:site": "node scripts/translate-site-incremental-with-deepl.mjs --write",
    "i18n:azure:site:check": "node scripts/translate-site-incremental-with-azure.mjs",
    "i18n:azure:site": "node scripts/translate-site-incremental-with-azure.mjs --write",
    "test:i18n": "npm run test:i18n:markup && npm run test:i18n:azure-adapter && npm run test:i18n:placeholders",
    "test:i18n:markup": "node scripts/translate-site-incremental-with-deepl.mjs --test-markup-protection",
    "test:i18n:azure-adapter": "node scripts/translate-site-incremental-with-azure.mjs --test-adapter",
    "test:i18n:placeholders": "node scripts/validate-i18n-placeholders.mjs",
    "test:file-format": "node scripts/validate-file-format-fixtures.mjs",
    "test:release-metadata": "node scripts/validate-current-release-metadata.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
